# systemd unit for Downgrooves.WorkerService
# Install:  sudo cp downgrooves-worker.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now downgrooves-worker
[Unit]
Description=Downgrooves iTunes worker service
After=network-online.target
Wants=network-online.target
# Stop retrying only if it crashes more than 5 times in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# The app calls UseSystemd(), so it reports when it is ready
Type=notify
# Change these two paths to where the worker is deployed and where dotnet is (run: which dotnet)
WorkingDirectory=/var/www/downgrooves-worker
ExecStart=/usr/bin/dotnet /var/www/downgrooves-worker/Downgrooves.WorkerService.dll
User=www-data
Group=www-data
Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1

# Restart whenever it stops, including a "clean" exit after an unhandled error
Restart=always
RestartSec=30

# The poll loop uses Thread.Sleep, so give it time to stop before it is killed
TimeoutStopSec=30
KillSignal=SIGINT
SyslogIdentifier=downgrooves-worker

[Install]
WantedBy=multi-user.target
